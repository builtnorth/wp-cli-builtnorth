{
    "name": "builtnorth/wp-cli-builtnorth",
    "description": "WP-CLI commands for BuiltNorth WordPress development",
    "type": "wp-cli-package",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "BuiltNorth",
            "email": "dev@builtnorth.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "wp-cli/wp-cli": "^2.5"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "BuiltNorth\\CLI\\": "inc/classes/"
        },
        "files": [
            "command.php"
        ]
    },
    "scripts": {
        "test": "echo 'WP-CLI package tests not yet configured'",
        "lint": "echo 'Linting not yet configured for WP-CLI package'"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "commands": [
            "builtnorth"
        ]
    }
}
