{
  "name": "builtnorth/wp-cli-builtnorth",
  "description": "WP-CLI commands for BuiltNorth WordPress development",
  "type": "wp-cli-package",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "BuiltNorth",
      "email": "dev@builtnorth.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "wp-cli/wp-cli": "^2.5"
  },
  "require-dev": {
    "10up/wp_mock": "^1.0",
    "builtnorth/coding-standards": "^1.0",
    "builtnorth/wp-mock-stand-ins": "^1.0",
    "mockery/mockery": "^1.5",
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "BuiltNorth\\CLI\\": "inc/classes/"
    },
    "files": [
      "command.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "BuiltNorth\\CLI\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html coverage",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "phpcompat": "phpcs -p inc command.php --standard=PHPCompatibility --runtime-set testVersion 8.1-"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "commands": [
      "builtnorth"
    ]
  }
}
